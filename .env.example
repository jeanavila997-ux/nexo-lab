# Nunca envie este arquivo com chaves reais. Copie para .env ou configure no ambiente do processo.

# Locais
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
LLAMA_CPP_BASE_URL=http://127.0.0.1:8081/v1
LLAMA_CPP_MODEL=

# CLIs (modelos vazios usam o padrão já configurado na ferramenta)
GEMINI_MODEL=
ANTIGRAVITY_MODEL=

# 9Router local
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=

# NVIDIA API Catalog / NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Ollama Cloud (ollama.com) - chave de https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=glm-5.3-flash
